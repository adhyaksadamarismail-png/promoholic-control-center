# Salin ke .env.local lalu isi. Nilai Supabase lokal ditampilkan oleh `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-dari-supabase-start

# Hanya dipakai di server (route login & manajemen staf). Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-dari-supabase-start

# CAPTCHA: Cloudflare Turnstile. Nilai di bawah adalah kunci uji resmi Cloudflare yang selalu lolos,
# hanya untuk pengembangan lokal. Ganti dengan kunci asli dari dashboard Cloudflare untuk staging/produksi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Domain internal untuk memetakan username ke email Supabase Auth.
STAFF_EMAIL_DOMAIN=staff.promoholic.local
